# All paths are optional. Relative paths in YAML are resolved from the project root.
II_PROJECT_ROOT=C:/AI/projects/CV
II_DATASET_ROOT=C:/AI/projects/CV/data/external
II_MODEL_ROOT=C:/AI/projects/CV/models
II_ARTIFACT_ROOT=C:/AI/projects/CV/reports/runtime
II_CONFIG=configs/deployment/local.yaml
II_MAX_IMAGE_BYTES=12582912
II_LOG_LEVEL=INFO

# Optional local caches on C:; set these only when the directories are needed. without overwriting global user variables.
HF_HOME=C:/AI/cache/huggingface
TORCH_HOME=C:/AI/cache/torch
PIP_CACHE_DIR=C:/AI/cache/pip
